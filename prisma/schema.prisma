// Enshrine Associate Management Portal (VirtualOffice)
// Canonical schema — mirrors docs/02_Database_Diagram.md (PRD v1.5).
// Conventions: models PascalCase @@map -> snake_case tables; fields camelCase
// @map -> snake_case columns; money = Decimal(14,2) SGD; soft-delete via
// archivedAt; UUID v4 PKs. Enum values @map to the exact DB strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (values @map to the exact strings in docs/02 §3)
// ---------------------------------------------------------------------------
// 16-Jul model. Sales designations (SA/SAM/SM/SD) drive the derived AppRole at
// onboarding (see roleForDesignation in lib/rbac.ts). Admin (= "Business Admin")
// and Accounts are system roles assigned to office staff, not sales designations.
enum AppRole {
  Admin
  Accounts
  SalesDirector
  SalesManager
  SalesAssistantManager
  SalesAssociate
}

enum Designation {
  // Managing Director (owner, 2026-10-07). A sales designation like the rest,
  // so it needs nothing special to reach the name card — that card already
  // prints the designation. Everyone holding it SHARES each product's
  // Managing Director cut; see server/commission/engine.ts.
  ManagingDirector      @map("Managing Director")
  SalesAssociate        @map("Sales Associate")
  SalesAssistantManager @map("Sales Assistant Manager")
  SalesManager          @map("Sales Manager")
  SalesDirector         @map("Sales Director")
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
  Incomplete
}

enum OnboardingStage {
  Invited
  FormSubmitted         @map("Form Submitted")
  SignedPendingApproval @map("Signed – Pending Approval")
  Approved
  Rejected
}

enum PFileDocType {
  SignedAssociateAgreement @map("Signed Associate Agreement")
  OnboardingSubmission     @map("Onboarding Submission")
  IDDocument               @map("ID Document")
  HRDocument               @map("HR Document")
  Other
}

enum AssociateStatus {
  Active
  Suspended
  Terminated
  Inactive
}

enum PaymentMethod {
  PayNow
  BankTransfer @map("Bank Transfer")
}

enum PaymentPlan {
  FullPayment @map("Full Payment")
  Installment
}

enum ProductActiveStatus {
  Active
  Inactive
}

// Product pricing (portal-facing sale price + instalment plan) — separate
// from commission/companyCut, which stay on their own versioned path
// (CommissionStructureVersion). None = one-time payment, no instalment
// fields; Months12 = a 12-month plan only; Months12or24 = the buyer can
// choose either term, so BOTH monthly amounts are collected up front.
enum InstalmentOption {
  None
  Months12
  Months12or24
}

// Closing basis (2026-10-01): which of the product's two prices commission,
// company cut and the overrides are calculated against. Independent of
// InstalmentOption/discountedPrice above — this only selects WHICH price is
// "the closing price" (lib/money.ts closingPrice()); it does not change how
// money is computed once that price is chosen.
enum ClosingBasis {
  ListedPrice
  DiscountedPrice
}

enum CommissionType {
  Percentage
  Fixed
}

enum ComValueType {
  Percentage
  Absolute
}

enum SubmissionStatus {
  Submitted
  QuotationApproved
  Rejected
  // A-17 phase 1 (own migration, ✎D2: the value can't be added and used in
  // the same transaction). Legacy submissions never reach this; ClosedDeal
  // ones do once phase 2 (flag on, gated on SEC-12) ships.
  Verified
}

// A-17: Legacy = the pre-A-17 quotation-approval/close flow (every existing
// row, permanently the column default — ✎D3). ClosedDeal = the new
// submit -> verify flow. New code sets ClosedDeal explicitly; nothing ever
// relies on the column default to produce it.
enum SubmissionFlow {
  Legacy
  ClosedDeal
}

// A-17: a Quotation is its own record, never touches money, never read by
// the commission engine.
enum QuotationStatus {
  Issued
  Converted
  Void
}

enum SubmissionDocKind {
  Supporting
  Signed
}

enum CommissionEligibility {
  Eligible
  PendingCollection @map("Pending Collection")
  PartiallyEligible @map("Partially Eligible")
  Ineligible
}

enum InvoiceType {
  ComputerGenerated @map("Computer-Generated")
  Signature
}

enum InvoiceStatus {
  Outstanding
  Paid
  Cancelled
}

enum InvoicePaymentMethod {
  Cash
  Credit
  Bank
}

enum LedgerLineType {
  Personal
  Override
  // The Managing Director's cut (owner, 2026-10-07). Deliberately its OWN type
  // rather than an Override: the owner's rule is that nobody but an admin ever
  // sees this figure, and only a distinguishable type lets every
  // associate-facing aggregate exclude it with one condition.
  ManagingDirectorCut @map("Managing Director Cut")
  AddOn           @map("Add-on")
  CompanyRetained @map("Company Retained")
  ExternalPayable @map("External Payable")
}

// Every received/paid aggregate over CommissionLedger must exclude
// Cancelled, even though nothing currently sets it (the engine only ever
// creates Pending/Eligible, and every payout-attachment site requires
// Eligible — so this is dormant today, not yet exercised by a live figure).
// The day something DOES cancel a line, an aggregate that forgot this
// predicate would silently include it. Nine call sites follow this rule —
// this list IS the fix, so keep it exact, not just "the ones that come to
// mind" (a basename match is not a path match: lib/recruitment-view.ts and
// components/recruitment/recruitment-view.tsx are two different files, 4719
// and 8340 bytes, and both are on this list for that reason):
// server/dashboard/rank.ts, server/dashboard/my-commissions.ts,
// lib/my-share.ts, lib/recruitment-view.ts,
// components/recruitment/recruitment-view.tsx, server/dashboard/metrics.ts's
// grossTransacted (pre-existing) and, added 2026-10-01 as a consistency
// fix, the same file's grossReceived and receivedInYear; and, added 2026-10-02
// (C-9), server/sales/team-commission-column.ts's
// fetchTeamSalesCommissionByTransaction (Team Sales' per-row Commission
// column).
enum LedgerStatus {
  Pending
  Eligible
  Paid
  Cancelled
}

enum PayoutStatus {
  Pending
  Approved
  Paid
  Cancelled
}

enum NoticeAudience {
  All
  Team
  Role
}

enum DocumentType {
  CompanyTemplate    @map("Company Template")
  AssociateAgreement @map("Associate Agreement")
  VendorAgreement    @map("Vendor Agreement")
  VendorMOU          @map("Vendor MOU")
  SalesAgreement     @map("Sales Agreement")
  Other
}

enum DocumentAssignment {
  All
  Team
  Associate
}

enum DocumentVisibility {
  All
  Owner
  Admin
}

// B-5 Doc Template (Option 1): categories for admin-uploaded reference
// templates on the portal Doc Template page (ADR-0002 decision 1).
enum TemplateCategory {
  PetsAfterlife
  HumanAfterlife
}

enum InstallmentPlanStatus {
  Active
  Completed
  Cancelled
}

enum PayoutKind {
  Regular
  Adjustment
}

enum BankFileStatus {
  Generated
  Uploaded
  Reconciled
}

enum VendorStatus {
  Active
  Lapsed
}

enum AshesAgreementStatus {
  Draft
  Signed
  // A-17 phase 1 (✎6): a signed agreement whose product is removed by a
  // later edit becomes Superseded. Own migration (the value can't be added
  // and used in the same transaction, same as SubmissionStatus.Verified).
  Superseded
  // Owner decision, 19 Oct 2026 (follow-up to the rejected-submission bug,
  // #3): a never-signed Draft agreement whose submission is rejected has no
  // existing value that fits — Superseded's precondition is everSigned, and
  // hard-delete was ruled out (it would delete the agreement the read-only
  // page opens). Own migration (20261019100000), same reason as the two
  // above. Written by rejectSubmission's cascade only; never by anything
  // that treats a submission as still live.
  Rejected
}

// ---------------------------------------------------------------------------
// Identity / HR
// ---------------------------------------------------------------------------
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         AppRole
  associateId  String?    @unique @map("associate_id") @db.Uuid
  associate    Associate? @relation("AssociateUser", fields: [associateId], references: [id])
  isActive     Boolean    @default(true) @map("is_active")

  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  // Forces a password change on next login (set when a login is provisioned
  // with a temp password or when an admin resets it; cleared on password change).
  mustResetPassword Boolean @default(false) @map("must_reset_password")

  pFile              PFile?
  nameCards          NameCard[]
  noticeReads        NoticeRead[]
  invitedCandidates  Candidate[]  @relation("CandidateInvitedBy")
  reviewedCandidates Candidate[]  @relation("CandidateReviewedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Candidate {
  id                     String          @id @default(uuid()) @db.Uuid
  fullName               String          @map("full_name")
  mobileNumber           String          @map("mobile_number")
  email                  String
  intendedDesignation    Designation?    @map("intended_designation")
  intendedDirectUplineId String?         @map("intended_direct_upline_id") @db.Uuid
  intendedDirectUpline   Associate?      @relation("CandidateIntendedUpline", fields: [intendedDirectUplineId], references: [id])
  intendedTeam           String?         @map("intended_team")
  // Commencement date (16-Jul): a Business Admin may set it on the invite;
  // otherwise it defaults to the agreement send date at onboarding.
  commencementDate       DateTime?       @map("commencement_date") @db.Date
  onboardingToken        String          @unique @map("onboarding_token")
  onboardingStage        OnboardingStage @default(Invited) @map("onboarding_stage")
  submittedPayload       Json?           @map("submitted_payload")
  photoFileKey           String?         @map("photo_file_key")
  agreementFileKey       String?         @map("agreement_file_key")
  signedAgreementFileKey String?         @map("signed_agreement_file_key")
  // CR-0001: the CompanySignatory snapshot taken at the same moment
  // signedAgreementFileKey is set (signAtSubmission), so a later change to
  // CompanySignatory never alters an already-signed agreement. Null until
  // signed; never read live at render/view time once set.
  companySignatoryNameAtSigning     String? @map("company_signatory_name_at_signing")
  companySignatureFileKeyAtSigning  String? @map("company_signature_file_key_at_signing")
  invitedById            String?         @map("invited_by") @db.Uuid
  invitedBy              User?           @relation("CandidateInvitedBy", fields: [invitedById], references: [id])
  reviewedById           String?         @map("reviewed_by") @db.Uuid
  reviewedBy             User?           @relation("CandidateReviewedBy", fields: [reviewedById], references: [id])
  rejectReason           String?         @map("reject_reason")
  convertedAssociateId   String?         @map("converted_associate_id") @db.Uuid
  convertedAssociate     Associate?      @relation("CandidateConverted", fields: [convertedAssociateId], references: [id])

  // The associate code allocated to this candidate at SIGNING, so it exists in
  // time to be printed into the agreement (the signed PDF is never modified
  // afterwards, so it cannot be stamped on later).
  //
  // 🔴 @unique IS LOAD-BEARING, NOT DEFENSIVE. nextAssociateCode is a
  // read-then-compute with no lock, so concurrent callers do propose the same
  // number; what prevented a duplicate before was Associate.associateCode's own
  // unique index, which rejected the loser loudly and harmlessly, before any
  // document existed. Allocating earlier moves that burden here. Without this
  // constraint two candidates could both reserve EN0005, both sign immutable
  // PDFs printing EN0005, and the clash would surface only at approval — after
  // two unalterable signed contracts already carried the same number.
  //
  // Nullable, and NULL is excluded from uniqueness by Postgres, so any number of
  // candidates may hold no reservation at once: pre-existing rows, invited rows
  // that never submitted, and rejected rows all keep NULL without colliding.
  reservedAssociateCode  String?         @unique @map("reserved_associate_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("candidates")
}

model Associate {
  id                     String          @id @default(uuid()) @db.Uuid
  associateCode          String          @unique @map("associate_code")
  fullName               String          @map("full_name")
  businessName           String?         @map("business_name")
  mobileNumber           String?         @map("mobile_number")
  email                  String?
  nric                   String? // encrypted at rest, masked in UI
  dateOfBirth            DateTime?       @map("date_of_birth") @db.Date
  designation            Designation
  directUplineId         String?         @map("direct_upline_id") @db.Uuid
  directUpline           Associate?      @relation("DirectUpline", fields: [directUplineId], references: [id])
  directDownline         Associate[]     @relation("DirectUpline")
  secondUplineId         String?         @map("second_upline_id") @db.Uuid
  secondUpline           Associate?      @relation("SecondUpline", fields: [secondUplineId], references: [id])
  secondDownline         Associate[]     @relation("SecondUpline")
  recruitingManager      String?         @map("recruiting_manager")
  teamName               String?         @map("team_name")
  paymentMethod          PaymentMethod?  @map("payment_method")
  paynowNumber           String?         @map("paynow_number")
  bankName               String?         @map("bank_name")
  bankAccountNumber      String?         @map("bank_account_number") // encrypted
  agreementFileKey       String?         @map("agreement_file_key")
  signedAgreementFileKey String?         @map("signed_agreement_file_key")
  // CR-0001: copied verbatim from Candidate at approveCandidate, the same way
  // signedAgreementFileKey is copied — never re-derived from a live
  // CompanySignatory read.
  companySignatoryNameAtSigning     String? @map("company_signatory_name_at_signing")
  companySignatureFileKeyAtSigning  String? @map("company_signature_file_key_at_signing")
  photoFileKey           String?         @map("photo_file_key")
  joinDate               DateTime?       @map("join_date") @db.Date
  approvalStatus         ApprovalStatus  @default(Pending) @map("approval_status")
  associateStatus        AssociateStatus @default(Inactive) @map("associate_status")

  user                    User?              @relation("AssociateUser")
  pFile                   PFile?
  closedSubmissions       SalesSubmission[]  @relation("SubmissionCloser")
  closedTransactions      SalesTransaction[] @relation("TransactionCloser")
  quotations              Quotation[]
  paymentVouchers         PaymentVoucher[]
  ledgerLines             CommissionLedger[]
  payouts                 MonthlyPayout[]
  vendorReferrals         VendorReferral[]
  assignedDocuments       Document[]         @relation("DocAssignedAssociate")
  ownedDocuments          Document[]         @relation("DocOwner")
  candidateIntendedUpline Candidate[]        @relation("CandidateIntendedUpline")
  convertedFromCandidate  Candidate[]        @relation("CandidateConverted")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  @@index([directUplineId])
  @@index([approvalStatus, associateStatus])
  @@map("associates")
}

model PFile {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @unique @map("user_id") @db.Uuid
  user        User            @relation(fields: [userId], references: [id])
  associateId String?         @unique @map("associate_id") @db.Uuid
  associate   Associate?      @relation(fields: [associateId], references: [id])
  notes       String?
  documents   PFileDocument[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("p_files")
}

model PFileDocument {
  id        String       @id @default(uuid()) @db.Uuid
  pFileId   String       @map("p_file_id") @db.Uuid
  pFile     PFile        @relation(fields: [pFileId], references: [id])
  docType   PFileDocType @map("doc_type")
  title     String
  fileKey   String       @map("file_key")
  filedById String?      @map("filed_by") @db.Uuid
  filedAt   DateTime     @map("filed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("pfile_documents")
}

model NameCard {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id])
  companyId            String?  @map("company_id") @db.Uuid
  company              Company? @relation(fields: [companyId], references: [id])
  chineseName          String?  @map("chinese_name")
  customTitle          String?  @map("custom_title")
  qrPayload            String?  @map("qr_payload")
  lastRenderedVcfKey   String?  @map("last_rendered_vcf_key")
  lastRenderedImageKey String?  @map("last_rendered_image_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("name_cards")
}

// ---------------------------------------------------------------------------
// Companies / Products / Commission structure
// ---------------------------------------------------------------------------
model Company {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  legalName      String? @map("legal_name")
  logoFileKey    String? @map("logo_file_key")
  stampFileKey   String? @map("stamp_file_key")
  address        String?
  invoicePrefix  String  @unique @map("invoice_prefix")
  invoiceNextSeq Int     @default(1) @map("invoice_next_seq")
  gstRegistered  Boolean @default(false) @map("gst_registered")
  gstRate        Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  active         Boolean @default(true)

  // Company details printed on generated documents. All nullable; an Admin
  // fills them in on /admin/company. An unset value falls back to what the
  // documents printed before these were fillable (see lib/company-identity.ts).
  /// This company's own registration number (UEN): header and footer.
  uen          String? @map("uen")
  /// The company's PayNow UEN: the invoice's PayNow payment line. May differ
  /// from `uen`.
  paynowUen    String? @map("paynow_uen")
  /// GST registration number: printed on TAX invoices only (never on a plain
  /// invoice or a quotation). Independent of `gstRegistered`/`gstRate`, which
  /// still decide whether a document is a tax invoice.
  gstRegNo     String? @map("gst_reg_no")
  contactEmail String? @map("contact_email")
  phone        String?
  website      String?

  products  Product[]
  lineItems SaleLineItem[]
  invoices  Invoice[]
  nameCards NameCard[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model Product {
  id                         String              @id @default(uuid()) @db.Uuid
  productCode                String              @map("product_code")
  productName                String              @map("product_name")
  productCategory            String?             @map("product_category")
  commissionType             CommissionType      @default(Percentage) @map("commission_type")
  closingCommPct             Decimal?            @map("closing_comm_pct") @db.Decimal(7, 4)
  closingCommFixed           Decimal?            @map("closing_comm_fixed") @db.Decimal(14, 2)
  // Company cut + overrides can each be a % of the sale or an absolute $ amount
  // (16-Jul (d)). Widened to (14,4) so the same column holds either. The *Type
  // column records which; existing rows default to Percentage (unchanged).
  companyCutPct              Decimal             @default(0) @map("company_cut_pct") @db.Decimal(14, 4)
  companyCutType             ComValueType        @default(Percentage) @map("company_cut_type")
  asmOverridePct             Decimal             @default(0) @map("asm_override_pct") @db.Decimal(7, 4)
  smOverridePct              Decimal             @default(0) @map("sm_override_pct") @db.Decimal(14, 4)
  smOverrideType             ComValueType        @default(Percentage) @map("sm_override_type")
  sdOverridePct              Decimal             @default(0) @map("sd_override_pct") @db.Decimal(14, 4)
  sdOverrideType             ComValueType        @default(Percentage) @map("sd_override_type")
  // Managing Director's cut (owner, 2026-10-07). Mechanically identical to the
  // SM/SD overrides above — a % of the SALES AMOUNT or an absolute value,
  // resolved per line and taken out of what the company keeps — but paid to
  // EVERY associate holding the ManagingDirector designation, shared equally
  // between them, rather than to a position in the closer's upline chain. Defaults to 0 so EVERY product
  // that exists today keeps its current arithmetic until an admin sets it; the
  // "30% of the company cut" default applies to the FORM, not the column.
  mdCutPct                   Decimal             @default(0) @map("md_cut_pct") @db.Decimal(14, 4)
  mdCutType                  ComValueType        @default(Percentage) @map("md_cut_type")
  companyRetainedPct         Decimal?            @map("company_retained_pct") @db.Decimal(7, 4)
  isExternal                 Boolean             @default(false) @map("is_external")
  // Widened from (7,4) to (14,4) and given a type column (owner CR1, 2026-10-08):
  // this was the ONLY commission field that could not be an absolute amount —
  // company cut, SM, SD and the MD cut all already carried a ComValueType. The
  // narrow precision was what made it percentage-only in practice: (7,4) tops
  // out below 1,000, so it could never have held a dollar figure.
  externalCompanyRetainedPct  Decimal?           @map("external_company_retained_pct") @db.Decimal(14, 4)
  externalCompanyRetainedType ComValueType       @default(Percentage) @map("external_company_retained_type")
  defaultCompanyId           String?             @map("default_company_id") @db.Uuid
  defaultCompany             Company?            @relation(fields: [defaultCompanyId], references: [id])
  parentProductId            String?             @map("parent_product_id") @db.Uuid
  parentProduct              Product?            @relation("ProductUpgrade", fields: [parentProductId], references: [id])
  upgrades                   Product[]           @relation("ProductUpgrade")
  activeStatus               ProductActiveStatus @default(Active) @map("active_status")
  effectiveDate              DateTime            @map("effective_date") @db.Date
  // Owner-requested product description, shown to associates and on the
  // admin list/forms. Reuses what was the dead `remarks` column (owner's
  // ruling, considered and overruled against adding a sibling column) —
  // renamed via migration, never written or read as a Product field before
  // this change (prisma/migrations/<ts>_rename_product_remarks_to_description).
  // No @map needed: Prisma's default column name IS "description", which the
  // migration's zero-drift check (see that migration's own comment) proves.
  description                String?

  // A-17 ⓢ Q6: per-product required-document checklist, e.g. [{key, label_en,
  // label_zh}]. Empty means nothing is required for this product; G3 checks
  // the union across a sale's products against the tagged uploads.
  requiredDocuments      Json    @default("[]") @map("required_documents")
  // A-17 Q4: drives automatic Pet Ash agreement generation at submit (§4).
  requiresAshesAgreement Boolean @default(false) @map("requires_ashes_agreement")

  // Pricing (2026-09-30): nullable because existing rows predate this
  // feature — the admin form REQUIRES listedPrice for any create/edit going
  // forward (lib/schemas.ts productPricingSchema), but the column itself
  // must accept null so this migration is additive, no backfill.
  listedPrice     Decimal? @map("listed_price") @db.Decimal(14, 2)
  discountedPrice Decimal? @map("discounted_price") @db.Decimal(14, 2)
  // Instalments (owner's change, 2026-10-09): full payment is always
  // available and is the absence of a constraint, never a row. instalment
  // plans are a repeatable add-on list (ProductInstalmentPlan below), one
  // row per admin-typed month count, replacing the fixed Months12/
  // Months12or24 enum. bookingFee stays a Product column — one fee per
  // product, shared by every plan on it, not per-plan.
  //
  // instalmentOption/monthlyInstalment12/monthlyInstalment24 below are FROZEN
  // (migration 20261009_product_instalment_plans backfills ProductInstalmentPlan
  // from them, then nothing reads or writes them again) — left in place,
  // nullable, for one release rather than dropped, since that backfill has
  // never run on production data and a dropped column can't be rolled back.
  instalmentOption    InstalmentOption @default(None) @map("instalment_option")
  bookingFee          Decimal?         @map("booking_fee") @db.Decimal(14, 2)
  monthlyInstalment12 Decimal?         @map("monthly_instalment_12") @db.Decimal(14, 2)
  monthlyInstalment24 Decimal?         @map("monthly_instalment_24") @db.Decimal(14, 2)
  // Closing basis (2026-10-01): additive, NOT NULL with a DB default so
  // every pre-existing row becomes ListedPrice (owner's ruling — "it should
  // be the same as listed price") without a backfill. zod defaults new
  // writes to the same value when the caller omits it.
  closingBasis ClosingBasis @default(ListedPrice) @map("closing_basis")

  comCodes       Comcode[]
  versions       CommissionStructureVersion[]
  instalmentPlans ProductInstalmentPlan[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  @@unique([productCode, effectiveDate])
  @@map("products")
}

// Owner's change (2026-10-09): instalments are a repeatable add-on list, not
// a fixed 12/24-month enum choice. Full payment is NOT a row here — every
// product has it, always; "no rows" means "full payment only". monthlyAmount
// is the quoted monthly the admin form computes (round2((closing price −
// Product.bookingFee) / months)) and may freely override — same arithmetic
// the sale side already runs per-sale (server/sales/actions.ts), just quoted
// ahead of time at the product level.
model ProductInstalmentPlan {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  months        Int
  monthlyAmount Decimal? @map("monthly_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Two 12-month plans on one product is nonsense (the owner's framing) —
  // enforced here, not just in the form.
  @@unique([productId, months])
  @@map("product_instalment_plans")
}

model Comcode {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @map("product_id") @db.Uuid
  product   Product      @relation(fields: [productId], references: [id])
  comCode   String       @map("com_code")
  label     String
  valueType ComValueType @map("value_type")
  value     Decimal      @db.Decimal(14, 4)
  active    Boolean      @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("com_codes")
}

model CommissionStructureVersion {
  id            String         @id @default(uuid()) @db.Uuid
  productCode   String         @map("product_code")
  productId     String?        @map("product_id") @db.Uuid
  product       Product?       @relation(fields: [productId], references: [id])
  effectiveDate DateTime       @map("effective_date") @db.Date
  rateSnapshot  Json           @map("rate_snapshot")
  lineItems     SaleLineItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productCode, effectiveDate])
  @@map("commission_structure_versions")
}

// ---------------------------------------------------------------------------
// Sales: submission (header) -> line items -> transaction
// ---------------------------------------------------------------------------
model SalesSubmission {
  id                         String           @id @default(uuid()) @db.Uuid
  salesDate                  DateTime         @map("sales_date") @db.Date
  clientName                 String           @map("client_name")
  clientContact              String?          @map("client_contact")
  saleAmount                 Decimal          @map("sale_amount") @db.Decimal(14, 2)
  paymentPlan                PaymentPlan      @map("payment_plan")
  deposit                    Decimal?         @db.Decimal(14, 2)
  installmentCount           Int?             @map("installment_count")
  amountCollected            Decimal          @default(0) @map("amount_collected") @db.Decimal(14, 2)
  closingAssociateId         String           @map("closing_associate_id") @db.Uuid
  closingAssociate           Associate        @relation("SubmissionCloser", fields: [closingAssociateId], references: [id])
  // Flow-3 Net-to-Closer split. Associate 1 = closingAssociate (submitter);
  // Associate 2 / 3 each get a % of Net-to-Closer or an absolute amount. Plain
  // UUID columns (no FK relation) — the ledger row carries the payable relation.
  associate2Id               String?          @map("associate2_id") @db.Uuid
  associate2ValueType        ComValueType?    @map("associate2_value_type")
  associate2Value            Decimal?         @map("associate2_value") @db.Decimal(14, 4)
  associate3Id               String?          @map("associate3_id") @db.Uuid
  associate3ValueType        ComValueType?    @map("associate3_value_type")
  associate3Value            Decimal?         @map("associate3_value") @db.Decimal(14, 4)
  // Date of quotation (23-Jul parallel workflow): filled by the rep up front, at
  // submission — drives the generated quotation.
  quoteDate                  DateTime?        @map("quote_date") @db.Date
  // Split approval (23-Jul, two-step + parallel to quotation generation). The
  // split's SD is defaulted to the closer's team director at submission
  // (splitDirectorId; the first team's director when several) and is
  // admin-reassignable. Flow A: the SD approves (sdApprovedAt; auto-approves 3
  // calendar days after submission — sdApprovedById null for that system actor),
  // then a Business Admin signs off (splitAdminApprovedAt). Runs in parallel with
  // quotation-generation approval (which advances `status`), not before it.
  splitDirectorId            String?          @map("split_director_id") @db.Uuid
  sdApprovedAt               DateTime?        @map("sd_approved_at")
  sdApprovedById             String?          @map("sd_approved_by") @db.Uuid
  splitAdminApprovedAt       DateTime?        @map("split_admin_approved_at")
  splitAdminApprovedById     String?          @map("split_admin_approved_by") @db.Uuid
  // SEC-5: when an edit last changed the commission split terms (and cleared the
  // split approvals). The SD's 3-day auto-approve counts from here, not createdAt.
  splitEditedAt              DateTime?        @map("split_edited_at")
  // B-S6 (owner ruling 2026-09-26: warn, don't block): a split that pushes any commission line
  // below zero is allowed, but needs a Business Admin "split exception" before it can close.
  // The approval covers the exact negative lines it saw (snapshot) and the split version it
  // was given for; any split edit or a worse recompute at close voids it.
  splitExceptionRequired     Boolean          @default(false) @map("split_exception_required")
  splitExceptionApprovedAt   DateTime?        @map("split_exception_approved_at")
  splitExceptionApprovedById String?          @map("split_exception_approved_by") @db.Uuid
  splitExceptionReason       String?          @map("split_exception_reason")
  splitExceptionSnapshot     Json?            @map("split_exception_snapshot")
  splitExceptionVersion      DateTime?        @map("split_exception_version")
  // Closure (23-Jul): the associate closes the sale once the quotation is signed
  // and the split is fully approved — that mints the transaction/ledger/invoice.
  closedAt                   DateTime?        @map("closed_at")
  closedById                 String?          @map("closed_by") @db.Uuid
  invoiceFileKey             String?          @map("invoice_file_key")
  remarks                    String?
  status                     SubmissionStatus @default(Submitted)

  // A-17 phase 1 (§2). flow's default of Legacy is PERMANENT (✎D3) — new code
  // always sets ClosedDeal explicitly on create.
  flow            SubmissionFlow @default(Legacy)
  rejectedAt      DateTime?      @map("rejected_at")
  // Bumped on every closer edit / doc add-remove / ashes save-sign, NOT by
  // approvals (✎S1). verifySale's G4 is a CAS on the value the admin's verify
  // page rendered.
  contentVersion  Int            @default(0) @map("content_version")
  // Assigned at submit from transaction_code_seq; copied to
  // SalesTransaction.transactionCode at verify. Nullable + unique: gaps from
  // rejected sales are fine (the code is opaque), and every Legacy row stays
  // NULL here (its code lives on the transaction only).
  transactionCode String?        @unique @map("transaction_code")
  // The admin verification stamp (plain id, no FK — same convention as
  // SalesTransaction.verifiedById). SalesTransaction gets the same values.
  // ⚠ On Legacy rows these two don't exist; closedAt/closedById already carry
  // that meaning for the old flow.
  verifiedAt      DateTime?      @map("verified_at")
  verifiedById    String?        @map("verified_by") @db.Uuid
  // Informational only (§2): converting a quotation prefills the submission,
  // but the submission's own lines stay authoritative.
  quotationId     String?        @map("quotation_id") @db.Uuid
  quotation       Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  lineItems      SaleLineItem[]
  transaction    SalesTransaction?
  documents      SubmissionDocument[]
  ashesAgreement PetsAshesAgreement?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([quotationId])
  @@map("sales_submissions")
}

// Freeform documents attached to a sale (16-Jul quotation workflow). `Supporting`
// = uploaded by the rep at/around submission (admin reviews before approving the
// quotation); `Signed` = client-signed documents uploaded into the sale's docket
// after the quotation is generated. Files live in the lib/storage object store.
model SubmissionDocument {
  id             String            @id @default(uuid()) @db.Uuid
  submissionId   String            @map("submission_id") @db.Uuid
  submission     SalesSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind           SubmissionDocKind
  fileKey        String            @map("file_key")
  fileName       String            @map("file_name")
  uploadedById   String?           @map("uploaded_by") @db.Uuid
  // A-17 ⓢ Q6: which of the product's required-document keys this upload
  // satisfies. NULL for every existing document (untagged).
  requirementKey String?           @map("requirement_key")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([submissionId])
  @@map("submission_documents")
}

// Monthly sales quota per associate (16-Jul §3). Set by a manager/director for
// their team member; a Director's value overrides a Manager's (setByRole records
// the setter's authority so a lower tier can't overwrite a higher one). Plain
// associate_id column (no relation) — matches the split-field convention.
model SalesQuota {
  id          String  @id @default(uuid()) @db.Uuid
  associateId String  @map("associate_id") @db.Uuid
  month       String // YYYY-MM
  amount      Decimal @db.Decimal(14, 2)
  setByRole   AppRole @map("set_by_role")
  setById     String? @map("set_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([associateId, month])
  @@map("sales_quotas")
}

// Team (16-Jul): Business Admin creates/names teams; each is headed by one
// Director. Associates can belong to MULTIPLE teams (via TeamMember). directorId
// + associateId are plain UUID columns (no FK relation) — matches the
// split/quota convention and avoids Associate back-relations.
model Team {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @unique
  directorId String?      @map("director_id") @db.Uuid
  active     Boolean      @default(true)
  members    TeamMember[]
  quotas     TeamQuota[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

// Granularity of a target, stored explicitly. SalesQuota encodes it in the
// length of its `month` string ("YYYY-MM" vs "YYYY"); TeamQuota does not.
enum TargetPeriodType {
  Monthly
  Yearly
}

// Team-level sales target, set by the Business Admin. It is the DEFAULT target
// for a team's members; a per-associate SalesQuota row, when present, overrides
// it (lib/quota.ts resolveTarget). `period` is "YYYY-MM" when periodType is
// Monthly and "YYYY" when Yearly — the migration's CHECK constraint enforces
// that pairing, so the two can never disagree. setByRole/setById mirror
// SalesQuota's audit columns.
model TeamQuota {
  id         String           @id @default(uuid()) @db.Uuid
  teamId     String           @map("team_id") @db.Uuid
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  periodType TargetPeriodType @map("period_type")
  period     String
  amount     Decimal          @db.Decimal(14, 2)
  setByRole  AppRole          @map("set_by_role")
  setById    String?          @map("set_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, periodType, period])
  @@map("team_quotas")
}

model TeamMember {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  associateId String   @map("associate_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([teamId, associateId])
  @@map("team_members")
}

model SaleLineItem {
  id                     String                      @id @default(uuid()) @db.Uuid
  submissionId           String                      @map("submission_id") @db.Uuid
  submission             SalesSubmission             @relation(fields: [submissionId], references: [id])
  transactionId          String?                     @map("transaction_id") @db.Uuid
  transaction            SalesTransaction?           @relation(fields: [transactionId], references: [id])
  companyId              String                      @map("company_id") @db.Uuid
  company                Company                     @relation(fields: [companyId], references: [id])
  productCode            String                      @map("product_code")
  productName            String                      @map("product_name")
  commissionType         CommissionType              @map("commission_type")
  lineSaleAmount         Decimal                     @map("line_sale_amount") @db.Decimal(14, 2)
  quantity               Int                         @default(1)
  selectedComCodes       Json?                       @map("selected_com_codes")
  upgradeParentProductId String?                     @map("upgrade_parent_product_id") @db.Uuid
  structureVersionId     String?                     @map("structure_version_id") @db.Uuid
  structureVersion       CommissionStructureVersion? @relation(fields: [structureVersionId], references: [id])
  isExternal             Boolean                     @default(false) @map("is_external")

  ledgerLines CommissionLedger[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([submissionId])
  @@index([transactionId])
  @@map("sale_line_items")
}

model SalesTransaction {
  id                    String                @id @default(uuid()) @db.Uuid
  transactionCode       String                @unique @map("transaction_code")
  submissionId          String                @unique @map("submission_id") @db.Uuid
  submission            SalesSubmission       @relation(fields: [submissionId], references: [id])
  salesDate             DateTime              @map("sales_date") @db.Date
  clientName            String                @map("client_name")
  clientContact         String?               @map("client_contact")
  saleAmount            Decimal               @map("sale_amount") @db.Decimal(14, 2)
  paymentPlan           PaymentPlan           @map("payment_plan")
  deposit               Decimal?              @db.Decimal(14, 2)
  installmentCount      Int?                  @map("installment_count")
  amountCollected       Decimal               @default(0) @map("amount_collected") @db.Decimal(14, 2)
  closingAssociateId    String                @map("closing_associate_id") @db.Uuid
  closingAssociate      Associate             @relation("TransactionCloser", fields: [closingAssociateId], references: [id])
  directUplineId        String?               @map("direct_upline_id") @db.Uuid
  secondUplineId        String?               @map("second_upline_id") @db.Uuid
  commissionEligibility CommissionEligibility @default(Ineligible) @map("commission_eligibility")
  agreementFileKey      String?               @map("agreement_file_key")
  verifiedById          String?               @map("verified_by") @db.Uuid
  verifiedAt            DateTime?             @map("verified_at")
  remarks               String?
  // A-17 ⓢ Q33c: the closer/upline/split-partner snapshot frozen at
  // verifySale, so a later payment mark can't change WHO earns. NEW SALES
  // ONLY — NULL for every existing (legacy) transaction, no backfill; legacy
  // transactions keep the live upline/split resolution.
  commissionParties     Json?                 @map("commission_parties")

  lineItems       SaleLineItem[]
  invoices        Invoice[]
  installmentPlan InstallmentPlan?
  ledgerLines     CommissionLedger[]
  paymentVouchers PaymentVoucher[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([closingAssociateId])
  @@index([commissionEligibility])
  @@map("sales_transactions")
}

// ---------------------------------------------------------------------------
// A-17: quotations. Own record, generated from Doc Template, never touches
// money and is never read by the commission engine — `lines`/`total` are a
// JSONB snapshot at issue time precisely so a later product/rate change can't
// retroactively change an issued quotation.
// ---------------------------------------------------------------------------
model Quotation {
  id            String          @id @default(uuid()) @db.Uuid
  quotationCode String          @unique @map("quotation_code")
  associateId   String          @map("associate_id") @db.Uuid
  associate     Associate       @relation(fields: [associateId], references: [id])
  clientName    String          @map("client_name")
  clientContact String?         @map("client_contact")
  quoteDate     DateTime        @map("quote_date") @db.Date
  validUntil    DateTime?       @map("valid_until") @db.Date
  /// Snapshot at issue time: [{ productCode, productName, amount, addOns }].
  lines         Json
  total         Decimal         @db.Decimal(14, 2)
  status        QuotationStatus @default(Issued)
  createdById   String?         @map("created_by") @db.Uuid
  voidedAt      DateTime?       @map("voided_at")
  voidedById    String?         @map("voided_by") @db.Uuid
  voidReason    String?         @map("void_reason")

  convertedSubmissions SalesSubmission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([associateId])
  @@map("quotations")
}

// ---------------------------------------------------------------------------
// Invoicing / installments
// ---------------------------------------------------------------------------
model Invoice {
  id                String                @id @default(uuid()) @db.Uuid
  transactionId     String                @map("transaction_id") @db.Uuid
  transaction       SalesTransaction      @relation(fields: [transactionId], references: [id])
  companyId         String                @map("company_id") @db.Uuid
  company           Company               @relation(fields: [companyId], references: [id])
  invoiceNumber     String                @map("invoice_number")
  invoiceType       InvoiceType           @default(ComputerGenerated) @map("invoice_type")
  installmentIndex  Int?                  @map("installment_index")
  amount            Decimal               @db.Decimal(14, 2)
  status            InvoiceStatus         @default(Outstanding)
  paidDate          DateTime?             @map("paid_date")
  paidMarkedById    String?               @map("paid_marked_by") @db.Uuid
  // Payment capture on mark-Paid (Issues v1.0 #6): how the client tendered.
  paidMethod        InvoicePaymentMethod? @map("paid_method")
  paidReference     String?               @map("paid_reference")
  pdfFileKey        String?               @map("pdf_file_key")
  signedPdfFileKey  String?               @map("signed_pdf_file_key")
  // B-7: the payment acknowledgement (PDF/JPG/PNG) required to mark Paid;
  // admin-only, served by invoice id (ADR-0001) — never a raw storage key.
  paymentAckFileKey String?               @map("payment_ack_file_key")
  remarks           String?
  scheduleEntry     InstallmentSchedule?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, invoiceNumber])
  @@map("invoices")
}

model InstallmentPlan {
  id               String                @id @default(uuid()) @db.Uuid
  transactionId    String                @unique @map("transaction_id") @db.Uuid
  transaction      SalesTransaction      @relation(fields: [transactionId], references: [id])
  totalAmount      Decimal               @map("total_amount") @db.Decimal(14, 2)
  deposit          Decimal               @default(0) @db.Decimal(14, 2)
  installmentCount Int                   @map("installment_count")
  adjustableAmount Decimal?              @map("adjustable_amount") @db.Decimal(14, 2)
  status           InstallmentPlanStatus @default(Active)
  schedule         InstallmentSchedule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("installment_plans")
}

model InstallmentSchedule {
  id                String                @id @default(uuid()) @db.Uuid
  planId            String                @map("plan_id") @db.Uuid
  plan              InstallmentPlan       @relation(fields: [planId], references: [id])
  sequence          Int
  dueAmount         Decimal               @map("due_amount") @db.Decimal(14, 2)
  dueDate           DateTime?             @map("due_date") @db.Date
  invoiceId         String?               @unique @map("invoice_id") @db.Uuid
  invoice           Invoice?              @relation(fields: [invoiceId], references: [id])
  paid              Boolean               @default(false)
  paidDate          DateTime?             @map("paid_date")
  // B-7: markInstallmentPaid writes this row directly (no Invoice row
  // required), so an installment-only payment needs its own ack slot, and
  // (DevLead) its own method/reference — Invoice already had these.
  paymentAckFileKey String?               @map("payment_ack_file_key")
  paidMethod        InvoicePaymentMethod? @map("paid_method")
  paidReference     String?               @map("paid_reference")

  @@unique([planId, sequence])
  @@map("installment_schedule")
}

// ---------------------------------------------------------------------------
// Commission ledger / payouts
// ---------------------------------------------------------------------------
model CommissionLedger {
  id               String                @id @default(uuid()) @db.Uuid
  transactionId    String                @map("transaction_id") @db.Uuid
  transaction      SalesTransaction      @relation(fields: [transactionId], references: [id])
  lineItemId       String?               @map("line_item_id") @db.Uuid
  lineItem         SaleLineItem?         @relation(fields: [lineItemId], references: [id])
  payoutMonth      String                @map("payout_month") // YYYY-MM
  associateId      String?               @map("associate_id") @db.Uuid
  associate        Associate?            @relation(fields: [associateId], references: [id])
  associateName    String?               @map("associate_name")
  designation      Designation?
  lineType         LedgerLineType        @map("line_type")
  comCode          String?               @map("com_code")
  basisAmount      Decimal               @map("basis_amount") @db.Decimal(14, 2)
  rateOrValue      Decimal?              @map("rate_or_value") @db.Decimal(14, 4)
  amount           Decimal               @db.Decimal(14, 2)
  isManualOverride Boolean               @default(false) @map("is_manual_override")
  overrideReason   String?               @map("override_reason")
  eligibility      CommissionEligibility @default(Ineligible)
  status           LedgerStatus          @default(Pending)
  remarks          String?
  // The payout that settles this line (M5). Null = not yet in any payout.
  payoutId         String?               @map("payout_id") @db.Uuid
  payout           MonthlyPayout?        @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([associateId, payoutMonth])
  @@index([transactionId])
  @@index([payoutId])
  @@map("commission_ledger")
}

model MonthlyPayout {
  id                 String             @id @default(uuid()) @db.Uuid
  payoutMonth        String             @map("payout_month")
  associateId        String             @map("associate_id") @db.Uuid
  associate          Associate          @relation(fields: [associateId], references: [id])
  // 0 = the month's regular payout; 1.. = adjustment payouts for lines that became
  // eligible after an earlier payout for the month was Approved/Paid (M5).
  seq                Int                @default(0)
  kind               PayoutKind         @default(Regular)
  ledgerLines        CommissionLedger[]
  paymentVouchers    PaymentVoucher[]
  associateName      String             @map("associate_name")
  designation        Designation
  personalCommission Decimal            @default(0) @map("personal_commission") @db.Decimal(14, 2)
  overrideCommission Decimal            @default(0) @map("override_commission") @db.Decimal(14, 2)
  addonCommission    Decimal            @default(0) @map("addon_commission") @db.Decimal(14, 2)
  totalPayable       Decimal            @default(0) @map("total_payable") @db.Decimal(14, 2)
  paymentMethod      PaymentMethod?     @map("payment_method")
  paynowNumber       String?            @map("paynow_number")
  bankName           String?            @map("bank_name")
  bankAccountNumber  String?            @map("bank_account_number") // encrypted
  payoutStatus       PayoutStatus       @default(Pending) @map("payout_status")
  paidDate           DateTime?          @map("paid_date")
  statementFileKey   String?            @map("statement_file_key")
  bankFileBatchId    String?            @map("bank_file_batch_id") @db.Uuid
  bankFileBatch      BankFileBatch?     @relation(fields: [bankFileBatchId], references: [id])
  remarks            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([associateId, payoutMonth, seq])
  @@map("monthly_payouts")
}

model BankFileBatch {
  id            String          @id @default(uuid()) @db.Uuid
  payoutMonth   String          @map("payout_month")
  fileKey       String?         @map("file_key")
  status        BankFileStatus  @default(Generated)
  generatedAt   DateTime        @default(now()) @map("generated_at")
  generatedById String?         @map("generated_by") @db.Uuid
  payouts       MonthlyPayout[]

  @@map("bank_file_batches")
}

// ---------------------------------------------------------------------------
// Virtual-office features
// ---------------------------------------------------------------------------
model Notice {
  id                String         @id @default(uuid()) @db.Uuid
  title             String
  body              String
  attachmentFileKey String?        @map("attachment_file_key")
  audience          NoticeAudience @default(All)
  audienceTeam      String?        @map("audience_team")
  audienceRole      AppRole?       @map("audience_role")
  postedById        String?        @map("posted_by") @db.Uuid
  publishedAt       DateTime       @default(now()) @map("published_at")
  reads             NoticeRead[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notices")
}

model NoticeRead {
  id       String   @id @default(uuid()) @db.Uuid
  noticeId String   @map("notice_id") @db.Uuid
  notice   Notice   @relation(fields: [noticeId], references: [id])
  userId   String   @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id])
  readAt   DateTime @default(now()) @map("read_at")

  @@unique([noticeId, userId])
  @@map("notice_reads")
}

model Document {
  id                  String             @id @default(uuid()) @db.Uuid
  type                DocumentType
  title               String
  fileKey             String             @map("file_key")
  ownerAssociateId    String?            @map("owner_associate_id") @db.Uuid
  ownerAssociate      Associate?         @relation("DocOwner", fields: [ownerAssociateId], references: [id])
  assignment          DocumentAssignment @default(All)
  assignedTeam        String?            @map("assigned_team")
  assignedAssociateId String?            @map("assigned_associate_id") @db.Uuid
  assignedAssociate   Associate?         @relation("DocAssignedAssociate", fields: [assignedAssociateId], references: [id])
  visibility          DocumentVisibility @default(All)
  uploadedById        String?            @map("uploaded_by") @db.Uuid

  // B-5 Doc Template (Option 1): `category` set means this row is an admin-
  // uploaded reference template, shown on the portal page alongside the
  // (unrelated, sha-pinned) built-in templates. On a new upload for the same
  // category, the previous one is retired (`retiredAt` set) and
  // `supersededById` points at the new row, in the same transaction as the
  // insert. "Exactly one non-retired row per category" is enforced ONLY by a
  // partial unique index in migration.sql (20261002090000_b5_doc_template_category)
  // — Prisma's schema DSL has no partial-index support, so it can't be
  // expressed here. No admin history UI, no un-retire. Reachability: a
  // retired row is 404 to everyone but admins at the download route
  // (app/documents/[id]/download) — a live URL must not keep distributing
  // a superseded template copy, even once it's gone from every listing.
  category       TemplateCategory? @map("category")
  retiredAt      DateTime?         @map("retired_at")
  supersededById String?           @map("superseded_by") @db.Uuid
  supersededBy   Document?         @relation("DocSupersession", fields: [supersededById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedes     Document[]        @relation("DocSupersession")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("documents")
}

model VendorReferral {
  id                     String       @id @default(uuid()) @db.Uuid
  vendorName             String       @map("vendor_name")
  vendorType             String?      @map("vendor_type")
  contact                String?
  agreementFileKey       String?      @map("agreement_file_key")
  submittedByAssociateId String?      @map("submitted_by_associate_id") @db.Uuid
  submittedByAssociate   Associate?   @relation(fields: [submittedByAssociateId], references: [id])
  submittedAt            DateTime     @default(now()) @map("submitted_at")
  status                 VendorStatus @default(Active)
  remarks                String?

  // Consolidated-menu rework (Sep 2026): referral partnership submissions are
  // visible to EVERYONE (dedupe — an associate checks the Partner list before
  // approaching a vendor) and require Business Admin approval. Pre-existing
  // registry rows were backfilled Approved.
  approvalStatus ApprovalStatus @default(Pending) @map("approval_status")
  reviewedById   String?        @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?      @map("reviewed_at")
  rejectReason   String?        @map("reject_reason")

  // Referral & Marketing Partnership Agreement e-form (docs/agreement-templates/
  // referral-marketing-partnership-agreement.pdf). Vendor signs in person on the
  // associate's device at submission; the Company countersigns at approval.
  agreementDate           DateTime? @map("agreement_date") @db.Date
  vendorUen               String?   @map("vendor_uen")
  vendorAddress           String?   @map("vendor_address")
  vendorSignerName        String?   @map("vendor_signer_name")
  vendorSignerNric        String?   @map("vendor_signer_nric")
  vendorSignerDesignation String?   @map("vendor_signer_designation")
  vendorSignatureKey      String?   @map("vendor_signature_key")
  companySignName         String?   @map("company_sign_name")
  companySignDesignation  String?   @map("company_sign_designation")
  companySignatureKey     String?   @map("company_signature_key")
  companySignedAt         DateTime? @map("company_signed_at")
  companySignedById       String?   @map("company_signed_by") @db.Uuid
  agreementPdfKey         String?   @map("agreement_pdf_key")

  // The company block as PRINTED when the VENDOR signed (AgreementCompanySnapshot,
  // lib/company-identity.ts). It needs a column of its own because the vendor signs
  // at submission and the Company countersigns at approval, which re-renders and
  // overwrites the stored PDF — so there has to be somewhere to hold the at-signing
  // values between those two moments. Taking the snapshot at approval instead would
  // make the countersigned document differ from the one the vendor actually saw and
  // signed. Null on every row submitted before this column existed; those render
  // from the constants, exactly as they did.
  signedCompany Json? @map("signed_company")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([approvalStatus])
  @@map("vendor_referrals")
}

// ---------------------------------------------------------------------------
// Storage of Pets Ashes Agreement (consolidated-menu rework, Sep 2026).
// One per sale: after the quotation is signed, the associate fills the
// application details web form; the data auto-fills this agreement (template
// docs/agreement-templates/storage-of-pets-ashes-agreement-v2607.pdf), the
// client signs in person on the associate's device, and the rendered PDF joins
// the sale's docket.
// ---------------------------------------------------------------------------
model PetsAshesAgreement {
  id           String          @id @default(uuid()) @db.Uuid
  submissionId String          @unique @map("submission_id") @db.Uuid
  submission   SalesSubmission @relation(fields: [submissionId], references: [id])

  storageSpaceLocation String? @map("storage_space_location")
  nicheUnit            String? @map("niche_unit")
  /// Rows of { name, breed, gender, dob, dateDismissed } (template table, max 10).
  pets                 Json    @default("[]")

  applicant1Name    String  @map("applicant1_name")
  applicant1Nric    String? @map("applicant1_nric")
  applicant1Address String? @map("applicant1_address")
  applicant1Contact String? @map("applicant1_contact")
  applicant1Email   String? @map("applicant1_email")
  applicant2Name    String? @map("applicant2_name")
  applicant2Nric    String? @map("applicant2_nric")
  applicant2Address String? @map("applicant2_address")
  applicant2Contact String? @map("applicant2_contact")
  applicant2Email   String? @map("applicant2_email")

  amountNumeric        Decimal     @map("amount_numeric") @db.Decimal(14, 2)
  amountWords          String      @map("amount_words")
  paymentPlan          PaymentPlan @map("payment_plan")
  bookingFee           Decimal?    @map("booking_fee") @db.Decimal(14, 2)
  monthlyInstalment    Decimal?    @map("monthly_instalment") @db.Decimal(14, 2)
  // The sale's actual instalment term (server/sales's installmentCount) —
  // added (2026-10-09) because the rendered agreement hardcoded "12" in its
  // prose regardless of the real term, wrong for every sale on a different
  // term. Backfilled from the linked submission's installmentCount for every
  // existing Installment-plan row (migration 20261009_ashes_instalment_months).
  instalmentMonths     Int?        @map("instalment_months")
  instalmentDayOfMonth Int?        @map("instalment_day_of_month")
  maintenanceStartYear Int?        @map("maintenance_start_year")
  additionalTerms      String?     @map("additional_terms")

  status                AshesAgreementStatus @default(Draft)
  signedAt              DateTime?            @map("signed_at")
  applicantSignatureKey String?              @map("applicant_signature_key")
  applicantWitnessName  String?              @map("applicant_witness_name")
  applicantWitnessNric  String?              @map("applicant_witness_nric")
  companyWitnessName    String?              @map("company_witness_name")
  companyWitnessNric    String?              @map("company_witness_nric")
  agreementPdfKey       String?              @map("agreement_pdf_key")

  // A-17 C2: the terms snapshot + stored-PDF hash taken at signing, so a
  // later edit to a term the agreement carries can be detected (compared
  // against the submission's current terms) and the signature voided.
  signedTerms      Json?   @map("signed_terms")
  signedPdfSha256  String? @map("signed_pdf_sha256") @db.Char(64)
  // Bumped each time a signature is voided and re-taken; 0 for every existing
  // (never-voided) row.
  signatureVersion Int     @default(0) @map("signature_version")

  createdById String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // N2 reconciler (server/agreements/stuck-signed-reconciler.ts): finds rows
  // stuck at Signed with no agreementPdfKey (a crash between the sign CAS
  // and the pdfKey transaction). Narrows on status first, same as the query.
  @@index([status, signedAt])
  @@map("pets_ashes_agreements")
}

// CR-0001: the company's signatory + signature stamped onto the associate
// onboarding agreement ("the company side" of lib/pdf/agreement.ts, currently
// blank). A singleton, not a new field on Company — Company's three rows
// (ENS/EPP/EAP) are per-entity invoicing identities; no Associate is linked
// to any of them, and the onboarding agreement is one document regardless of
// which entity later invoices that associate's sales. `singleton` + its
// unique constraint make a second row a DB error, not a race condition —
// writers always upsert `where: { singleton: true }`.
model CompanySignatory {
  id               String   @id @default(uuid()) @db.Uuid
  singleton        Boolean  @default(true) @unique
  signatoryName    String   @map("signatory_name")
  // Follows the Company.stampFileKey convention: a stored file key, not
  // inline image data.
  signatureFileKey String?  @map("signature_file_key")
  updatedById      String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("company_signatory")
}

// A-7: payment voucher per settling payout. One instalment sale paid across
// N payouts gets N vouchers (seq 1..N, ordered by settlement — paidDate,
// then payoutMonth, then payoutId — never by issue/download order); a sale
// paid in one go gets exactly one, numbered 1. Frozen at issue: everything
// below the first lookup for a given (transactionId, associateId,
// payoutId) runs exactly once — a later line Cancelled, or another payout
// settling more on the same transaction, never changes an already-issued
// voucher's content. Purely additive, no backfill: a transaction/payout
// pair simply has no voucher until first downloaded.
model PaymentVoucher {
  id            String           @id @default(uuid()) @db.Uuid
  transactionId String           @map("transaction_id") @db.Uuid
  transaction   SalesTransaction @relation(fields: [transactionId], references: [id])
  associateId   String           @map("associate_id") @db.Uuid
  associate     Associate        @relation(fields: [associateId], references: [id])
  payoutId      String           @map("payout_id") @db.Uuid
  payout        MonthlyPayout    @relation(fields: [payoutId], references: [id])
  reference     String           @unique
  // 1-based position among this (transaction, associate)'s SETTLING
  // payouts, ordered by (paidDate, payoutMonth, payoutId) — never a count
  // of already-issued vouchers (that races two different payouts onto the
  // same seq/reference when issued concurrently).
  seq           Int
  // Denormalized at issue, deliberately — an admin editing the associate's
  // name/code or the transaction's code later must not rewrite an already-
  // issued voucher's content.
  associateName   String  @map("associate_name")
  associateCode   String  @map("associate_code")
  transactionCode String  @map("transaction_code")
  clientInitials  String  @map("client_initials")
  payoutMonths    String[] @map("payout_months")
  paidDate        DateTime @map("paid_date")
  // VoucherLine[] (server/vouchers/get-or-create.ts) — this payout's own
  // settled lines only, frozen at issue.
  lines         Json
  totalPaid     Decimal  @map("total_paid") @db.Decimal(14, 2)
  issuedAt      DateTime @default(now()) @map("issued_at")
  issuedById    String?  @map("issued_by") @db.Uuid

  @@unique([transactionId, associateId, payoutId])
  @@index([transactionId, associateId])
  @@map("payment_vouchers")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Security controls (Phase 1d §4.2) — DB-backed rate-limit / lockout state.
// ---------------------------------------------------------------------------
model RateLimitAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  identifier  String
  action      String
  windowStart DateTime  @map("window_start")
  count       Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([identifier, action])
  @@map("rate_limit_attempts")
}

// ---------------------------------------------------------------------------
// UAT tracker (/uat) — testers record pass/fail/blocked per case; the case
// catalogue lives in code (lib/uat-cases.ts). Keyed by a tester-entered name so
// one person's run stays coherent while they log into different role accounts.
// ---------------------------------------------------------------------------
enum UatStatus {
  Untested
  Pass
  Fail
  Blocked
}

model UatResult {
  id          String    @id @default(uuid()) @db.Uuid
  caseId      String    @map("case_id")
  testerName  String    @map("tester_name")
  status      UatStatus @default(Untested)
  notes       String?
  updatedById String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([caseId, testerName])
  @@index([testerName])
  @@map("uat_results")
}

// ---------------------------------------------------------------------------
// B-9: Marketing libraries (Flyers / EDMs / Customisation / Greetings).
// Purely additive — no existing table is touched. Per ADR-0002 rev 3 and
// the migration-design review.
// ---------------------------------------------------------------------------
enum MarketingCategory {
  Flyers
  EDMs
  // The enum value stays "Customisation" even if the admin-facing label ever
  // changes (the owner's A-15 naming question) — that's an i18n copy change,
  // never a data migration.
  Customisation
  Greetings
}

model MarketingCollection {
  id          String            @id @default(uuid()) @db.Uuid
  category    MarketingCategory
  name        String // e.g. "Christmas 2026"
  createdById String?           @map("created_by") @db.Uuid
  // "No expiry" means no TTL, not "no way to retire one" — archiving hides a
  // collection (and its assets) from associates without deleting anything.
  archivedAt  DateTime?         @map("archived_at")
  assets      MarketingAsset[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("marketing_collections")
}

model MarketingAsset {
  id           String              @id @default(uuid()) @db.Uuid
  collectionId String              @map("collection_id") @db.Uuid
  // Restrict, not Cascade (code review): a cascade would delete the row
  // but leave the file orphaned on disk. The delete-collection action must
  // remove every asset's file first, then the assets, then the collection.
  collection   MarketingCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  fileKey      String              @map("file_key")
  fileName     String              @map("file_name")
  mimeType     String              @map("mime_type") // sniffed type, never the client-supplied one (SEC-11)
  sizeBytes    Int                 @map("size_bytes") // load-bearing: the library storage budget sums this
  sha256       String // per-collection dedupe (ADR-0002 U2) — see the partial unique index below
  archivedAt   DateTime?           @map("archived_at")
  uploadedById String?             @map("uploaded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([collectionId])
  // ADR-0002 U2: dedupe is per collection and only among active (non-
  // archived) assets, so re-uploading the same content after archiving the
  // original isn't blocked. Prisma's schema DSL can't express a PARTIAL
  // unique index, so this is NOT declared with @@unique here — the guarded
  // migration.sql is the source of truth:
  //   CREATE UNIQUE INDEX ... ON marketing_assets(collection_id, sha256)
  //   WHERE archived_at IS NULL;
  @@map("marketing_assets")
}
